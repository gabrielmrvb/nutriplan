#!/usr/bin/env bash
# Trava de push: o ATALHO local — SOBRE O COMMIT QUE SOBE.
#
# O GATE DE VERDADE É O CI (17/09/2026). Até esta data este hook rodava a
# suíte inteira (30–40 minutos) e era o único gate; um push chegou ao
# GitHub naquele dia sem passar pelo reflog de nenhuma sessão, e um gate que
# só existe numa máquina não é gate — ninguém consegue conferir se rodou.
# Hoje o gate é o CI: `suite-rapida.yml` (fatiada, `--exclude-tag lento`,
# < 10 min) barra todo PR — é o check que a fila local espera —, e
# `suite.yml` roda a suíte inteira depois do merge e à noite (18/09/2026).
# Este hook virou o atalho que pega regressão cara em poucos minutos, antes
# de gastar runner (privado, metered):
#
#   config                          régua de design, nomenclatura, disciplina
#   workouts.test_ficha_de_verdade  o teste dourado do dono
#   workouts.test_treino_md         a doutrina do TREINO.md
#   workouts.test_catalogo          o gate por letra
#   plans.test_stress               os orçamentos de consulta
#
# E O QUE A BRANCH TOCOU ENTRA JUNTO (16/09/2026): cada arquivo que o push
# muda desde `origin/main` soma o app dele ao atalho — `templates/workouts/`
# soma `workouts`, `static/js/` soma `push`, e a vitrine (`gestao`) entra
# sempre. É `scripts/hooks/escopo_do_push.py` quem decide, e ele tem teste.
# Sem `origin/main` local para comparar (clone raso, remoto com outro nome)
# fica o atalho fixo: o gate é o CI, e não saber o diff não muda isso.
#
# `NUTRIPLAN_SUITE_COMPLETA=1 git push ...` roda a suíte inteira aqui, como
# antes — para quem quer a resposta antes de abrir o PR.
#
# POR QUE NUM WORKTREE, E NÃO NA ÁRVORE DE TRABALHO. A versão anterior
# rodava `manage.py test` aqui mesmo, na árvore. Isso valida o que está no
# disco, que não é o que sobe: um arquivo não commitado (um teste novo, um
# dado de catálogo) entra na conta e não entra no push, e um arquivo
# commitado que foi apagado do disco sai da conta e entra no push. Foi assim
# que o pre-push de 15/09 passou "3044 OK" e o mesmo `main` reprovava dois
# dias depois — o teste que reprovou dependia do calendário, e a árvore
# testada não era o commit. O SHA do push é exportado num worktree
# descartável, o `.env` é copiado (o banco de teste é o da branch, com
# `_push` — ver abaixo — e o `RunnerUnico` continua valendo) e o subconjunto
# roda LÁ.
set -o errexit
set -o pipefail

# A RAIZ é onde moram o `.venv` e o `.env`: o worktree de onde o push sai e,
# quando ele não os tem (um worktree ligado, recém-criado), o repositório
# principal (`--git-common-dir` aponta para o `.git` de verdade).
RAIZ="${NUTRIPLAN_RAIZ:-$(git rev-parse --show-toplevel)}"
if [ ! -x "$RAIZ/.venv/Scripts/python.exe" ]; then
  RAIZ="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)"
fi
PY="$RAIZ/.venv/Scripts/python.exe"
[ -x "$PY" ] || PY="python"

# O git manda, no stdin, uma linha por ref: local_ref local_sha remote_ref remote_sha.
sha=""
while read -r local_ref local_sha remote_ref remote_sha; do
  # Push de remoção (sha zerado) não tem código para testar.
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi
  sha="$local_sha"
  ramo="${remote_ref#refs/heads/}"
done
if [ -z "$sha" ]; then
  echo "→ nada para testar (push sem commit)"
  exit 0
fi

WT="$(mktemp -d "${TMPDIR:-/tmp}/nutriplan-push-XXXXXX")"
limpar() {
  cd "$RAIZ"
  git worktree remove --force "$WT" >/dev/null 2>&1 || true
  rm -rf "$WT"
}
trap limpar EXIT

if [ "${NUTRIPLAN_SUITE_COMPLETA:-0}" = "1" ]; then
  ALVOS=""
  echo "→ suíte completa sobre $(git rev-parse --short "$sha") (worktree descartável)"
else
  ALVOS="config workouts.test_ficha_de_verdade workouts.test_treino_md workouts.test_catalogo plans.test_stress"
  base="$(git merge-base "$sha" refs/remotes/origin/main 2>/dev/null || true)"
  if [ -n "$base" ]; then
    # shellcheck disable=SC2046
    ALVOS="$ALVOS $("$PY" "$RAIZ/scripts/hooks/escopo_do_push.py" $(git diff --name-only "$base" "$sha"))"
  fi
  echo "→ atalho sobre $(git rev-parse --short "$sha") (worktree descartável): $ALVOS; o gate é o CI no PR"
fi
git worktree add --detach "$WT" "$sha" >/dev/null
[ -f "$RAIZ/.env" ] && cp "$RAIZ/.env" "$WT/.env"

# O BANCO DE TESTE É O DA BRANCH QUE SOBE, com sufixo próprio (27/09/2026).
# O `.env` copiado dava ao push o MESMO banco da sessão que empurrava — a
# colisão do ledger em 24/09. `config/branch.py` deriva o nome da branch; o
# `_push` separa o hook da suíte que a mesma sessão pode estar rodando. Banco
# só dele, então `--keepdb` não embaralha ninguém e poupa a migração a cada
# push. O log leva o slug da branch: dois pushes ao mesmo tempo não escrevem
# no mesmo arquivo. O slug vem do `config/branch.py` do `$WT` — o SHA que sobe,
# o mesmo commit deste hook —, e não da `$RAIZ`, que pode ser o checkout
# principal sem ele. SHA antigo sem o arquivo: `sem_branch`, e o push segue.
export NUTRIPLAN_BRANCH="$ramo" NUTRIPLAN_BANCO_SUFIXO=_push
slug=sem_branch
[ -f "$WT/config/branch.py" ] && slug="$("$PY" -c 'import sys; sys.path.insert(0, sys.argv[1]); from config.branch import slug; sys.stdout.write(slug(sys.argv[2]))' "$WT" "$ramo")"
LOG="${TMPDIR:-/tmp}/nutriplan-push-$slug.log"
# Schema velho no banco guardado (migração não mergeada reescrita com o mesmo nome)? Zere só ele: dropdb -U postgres test_nutriplan_<slug do log>_push (com _b antes do _push se o slug termina em número).

# `--noinput` nos testes não é detalhe: um banco de teste órfão de uma execução
# interrompida faz o Django PERGUNTAR se pode apagá-lo, e um hook não tem
# terminal para responder. Sem isto ele morre com EOFError e o push é
# abortado por um motivo que não tem nada a ver com o código. O `tee` não
# engole a falha: `pipefail` (lá em cima) mantém o código do teste mandando.
# shellcheck disable=SC2086
inicio=$(date +%s)
# Antes do teste: um push reprovado também diz onde está o log.
echo "→ log: $LOG"
( cd "$WT" && "$PY" manage.py test $ALVOS --verbosity=1 --noinput --keepdb ) 2>&1 | tee "$LOG"
# O tempo, dito: sozinho o atalho leva ~4 min; com três suítes de sessões
# diferentes disputando a máquina, 6–25 (medido em 17/09/2026). Quem vê o
# número sabe se é o hook ou a máquina.
echo "→ atalho levou $(( $(date +%s) - inicio )) s"

echo "✓ push liberado — o julgamento é o check \"suíte rápida\" no PR (log: $LOG)"
