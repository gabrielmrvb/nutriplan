<?xml version="1.0" encoding="utf-8"?>
<!-- Nada deste app sai do aparelho por backup ou por transferencia de celular.

     O que ele guarda e o token de acesso a conta e o percurso da corrida — por
     onde a pessoa passou e a que horas ela sai de casa. Backup automatico
     mandaria os dois para a nuvem do fabricante, e transferencia de aparelho
     os copiaria para o proximo telefone junto com tudo o mais.

     `allowBackup="false"` no manifesto ja fecha o caminho antigo; estas regras
     fecham os dois caminhos do Android 12+, que sao separados. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
