# Copie para .env e ajuste. NUNCA versione o .env.
#
# Em produção estas variáveis são configuradas no painel da plataforma
# (Render/Railway), não em arquivo. O render.yaml da raiz já declara todas.

# Gere uma nova com:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=troque-esta-chave-em-producao

# True só na sua máquina. Em produção precisa ser False: com DEBUG ligado
# qualquer erro devolve uma página com settings, caminhos e trechos de código.
DJANGO_DEBUG=True

# Separados por vírgula. Em produção, o domínio do site — Render e Railway
# preenchem o deles sozinhos (veja PLATFORM_HOST em config/settings.py).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origens que podem enviar formulário por HTTPS. Só é necessário quando o
# domínio final não é o que a plataforma injeta (domínio próprio, por exemplo).
DJANGO_CSRF_TRUSTED_ORIGINS=

# postgres://usuario:senha@host:porta/banco
# Em produção a plataforma injeta esta variável a partir do banco criado.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nutriplan

# Chaves VAPID para Web Push. Sem elas o app funciona e simplesmente não
# oferece notificação. Gere com:
#   .venv/Scripts/vapid.exe --gen
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=voce@exemplo.com
