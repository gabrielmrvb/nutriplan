{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nutriplan",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": [
        "manage.py",
        "runserver",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "forja",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": [
        "forja/manage.py",
        "runserver",
        "8100"
      ],
      "port": 8100
    },
    {
      "name": "moldes",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8123",
        "--directory",
        "moldes"
      ],
      "port": 8123
    }
  ]
}
